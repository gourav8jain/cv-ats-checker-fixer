# Copy to .env.local for local builds. In GitHub, set these as repository Variables.
# URL of your deployed payments worker. Leave empty for demo mode.
VITE_API_BASE=
# Public key printed by `npm run keys` (single-line JSON)
VITE_PUBLIC_KEY_JWK=
# stripe | razorpay | both
VITE_PAYMENT_PROVIDER=both
VITE_SUPPORT_EMAIL=support@example.com
VITE_WEB_URL=https://gourav8jain.github.io/cv-ats-checker-fixer/
